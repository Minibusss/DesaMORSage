/**
 * @brief La fonction permet de regrouper tous les tests pour la fonction verifierChaineValide
 * @param rien
 * @retval rien
 */
void test_verifierChaineValide(void)
{
	//Tests avec une chaine valide : ne prennent en compte que les lettres
	TEST_ASSERT_EQUAL_UINT8_MESSAGE(1,verifierChaineValide("ABC"),"La fonction renvoie 1 (vrai) si le nbrElement > 0.");
	TEST_ASSERT_EQUAL_UINT8_MESSAGE(1,verifierChaineValide("aBc"),"La fonction renvoie 1 (vrai) si le nbrElement > 0.");
	TEST_ASSERT_EQUAL_UINT8_MESSAGE(1,verifierChaineValide("ABCDZ"),"La fonction renvoie 1 (vrai) si le nbrElement > 0.");
	TEST_ASSERT_EQUAL_UINT8_MESSAGE(1,verifierChaineValide("ABCD#Z"),"La fonction renvoie 1 (vrai) si le nbrElement > 0.");

	//Tests avec une chaine non valide :
	TEST_ASSERT_EQUAL_UINT8_MESSAGE(0,verifierChaineValide("123"),"La fonction renvoie 0 (faux) si le nbrElement < 0.");
	TEST_ASSERT_EQUAL_UINT8_MESSAGE(0,verifierChaineValide("!@#"),"La fonction renvoie 0 (faux) si le nbrElement < 0.");
	TEST_ASSERT_EQUAL_UINT8_MESSAGE(0,verifierChaineValide(""),"La fonction renvoie 0 (faux) si le nbrElement < 0.");
}

/**
 * @brief La fonction permet de tester la fonction conversionChaineMorse pour la chaine ABCDE
 * @param rien
 * @retval rien
 */
void test_conversionChaineABCDE(void)
{
    uint8_t expectedABCDE[20] = {1,2,0,0,2,1,1,1,2,1,2,1,2,1,1,0,1,0,0,0};
	//TEST ABCDE
    uint8_t *resultABCDE = conversionChaineMorse("ABCDE");
    TEST_ASSERT_NOT_NULL(resultABCDE);
    TEST_ASSERT_EQUAL_UINT8_ARRAY(expectedABCDE, &resultABCDE[0], 20);   // ABCDE : permet de comparer tout le tableau pour A avec les quatres premiers éléments dans le tableau résultat
}

